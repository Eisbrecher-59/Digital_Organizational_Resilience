  keywords = {Biomineralization,Mechanical properties,Organic–inorganic nanostructures,Transmission electron microscopy},
  file = {/home/gillard/Zotero/storage/MZHB8JFB/Gim et al. - 2019 - Nanoscale deformation mechanics reveal resilience in nacre of Pinna nobilis shell.pdf}
}

@article{gim2022disaster,
