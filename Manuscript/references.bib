@article{gim2019nanoscale,
  title = {Nanoscale Deformation Mechanics Reveal Resilience in Nacre of {{Pinna}} Nobilis Shell},
  author = {Gim, Jiseok and Schnitzer, Noah and Otter, Laura M. and Cui, Yuchi and Motreuil, Sébastien and Marin, Frédéric and Wolf, Stephan E. and Jacob, Dorrit E. and Misra, Amit and Hovden, Robert},
