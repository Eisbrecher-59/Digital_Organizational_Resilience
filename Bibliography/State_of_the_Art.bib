  shorttitle = {The Low-Entropy City},
  author = {Pelorosso, R. and Gobattoni, F. and Leone, A.},
  date = {2017},
  journaltitle = {Landscape and Urban Planning},
  shortjournal = {Landscape and Urban Planning},
