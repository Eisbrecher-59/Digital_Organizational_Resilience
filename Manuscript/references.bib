@article{bodin2009role,
  title = {The Role of Social Networks in Natural Resource Governance: {{What}} Relational Patterns Make a Difference?},
  shorttitle = {The Role of Social Networks in Natural Resource Governance},
  author = {Bodin, Örjan and Crona, Beatrice I.},
  date = {2009},
  journaltitle = {Global Environmental Change},
  shortjournal = {Global Environmental Change},
  volume = {19},
