@article{kleitman2022applying,
  title = {Applying {{Evidence-Centered Design}} to {{Measure Psychological Resilience}}: {{The Development}} and {{Preliminary Validation}} of a {{Novel Simulation-Based Assessment Methodology}}},
  shorttitle = {Applying {{Evidence-Centered Design}} to {{Measure Psychological Resilience}}},
  author = {Kleitman, Sabina and Jackson, Simon A. and Zhang, Lisa M. and Blanchard, Matthew D. and Rizvandi, Nikzad B. and Aidman, Eugene},
